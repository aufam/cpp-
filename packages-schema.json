{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "package": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Package name"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+"
          },
          "edition": {
            "type": "integer",
            "default": 17,
            "enum": [14, 17, 20, 23, 26]
          },
          "authors": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": {
            "type": "string"
          },
          "license": {
            "type": "string"
          }
        }
      },

      "dependencies": {
        "type": "object",
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": ["version"],
              "properties": {
                "version": { "type": "string" },
                "features": { "type": "array", "items": { "type": "string" } },
                "optional": { "type": "boolean", "default": false },
                "default-features": { "type": "boolean", "default": true }
              }
            },
            {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": { "type": "string" },
                "features": { "type": "array", "items": { "type": "string" } },
                "optional": { "type": "boolean", "default": false },
                "default-features": { "type": "boolean", "default": true }
              }
            },
            {
              "type": "object",
              "required": ["git", "branch"],
              "properties": {
                "git": { "type": "string" },
                "branch": { "type": "string" },
                "features": { "type": "array", "items": { "type": "string" } },
                "optional": { "type": "boolean", "default": false },
                "default-features": { "type": "boolean", "default": true }
              }
            },
            {
              "type": "object",
              "required": ["git", "tag"],
              "properties": {
                "git": { "type": "string" },
                "tag": { "type": "string" },
                "features": { "type": "array", "items": { "type": "string" } },
                "optional": { "type": "boolean", "default": false },
                "default-features": { "type": "boolean", "default": true }
              }
            }
          ]
        }
      },

      "features": {
        "type": "object",
        "additionalProperties": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "src": {"type": "array", "items": { "type": "string" } },
                "inc": {"type": "array", "items": { "type": "string" } },
                "flags": {"type": "array", "items": { "type": "string" } },
                "link-flags": {"type": "array", "items": { "type": "string" } }
              }
            },
            {
              "type": "array",
              "items": { "type": "string" }
            }
          ]
        }
      },

      "targets": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "src": {"type": "array", "items": { "type": "string" } },
            "inc": {"type": "array", "items": { "type": "string" } },
            "flags": {"type": "array", "items": { "type": "string" } },
            "link-flags": {"type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
